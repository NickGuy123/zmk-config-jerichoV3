/*
 * Jericho V3 - custom ZMK shield
 *
 * Unibody board, single nice!nano v2, 5 rows x 12 columns, col2row diodes.
 *
 * Pin mapping and matrix population were traced directly from the KiCad
 * schematic (Jericho_V3), diode-by-diode. See README.md in this folder
 * for the full derivation notes.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 3 GPIO_ACTIVE_HIGH>  /* row0 */
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>  /* row1 */
            , <&pro_micro 0 GPIO_ACTIVE_HIGH>  /* row2 */
            , <&pro_micro 1 GPIO_ACTIVE_HIGH>  /* row3 */
            , <&pro_micro 4 GPIO_ACTIVE_HIGH>  /* row4 (thumbs) */
            ;

        col-gpios
            = <&pro_micro 10 GPIO_ACTIVE_HIGH>  /* col0  */
            , <&pro_micro 9  GPIO_ACTIVE_HIGH>  /* col1  */
            , <&pro_micro 8  GPIO_ACTIVE_HIGH>  /* col2  */
            , <&pro_micro 7  GPIO_ACTIVE_HIGH>  /* col3  */
            , <&pro_micro 6  GPIO_ACTIVE_HIGH>  /* col4  */
            , <&pro_micro 5  GPIO_ACTIVE_HIGH>  /* col5  */
            , <&pro_micro 16 GPIO_ACTIVE_HIGH>  /* col6  */
            , <&pro_micro 14 GPIO_ACTIVE_HIGH>  /* col7  */
            , <&pro_micro 15 GPIO_ACTIVE_HIGH>  /* col8  */
            , <&pro_micro 18 GPIO_ACTIVE_HIGH>  /* col9  */
            , <&pro_micro 19 GPIO_ACTIVE_HIGH>  /* col10 */
            , <&pro_micro 20 GPIO_ACTIVE_HIGH>  /* col11 */
            ;
    };

    /*
     * Reading order below is: row3 (top row) -> row2 -> row1 -> row0
     * (bottom row of the main block), left to right across all 12
     * columns, then the 4 thumb keys on row4 (only columns 4,5,6,7 are
     * wired on row4 - confirmed from the schematic).
     *
     * This order must match the order of key bindings in your keymap's
     * layers 1:1.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;

        map = <
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)   RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)   RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)   RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)   RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
                        RC(4,4) RC(4,5)   RC(4,6) RC(4,7)
        >;
    };
};
