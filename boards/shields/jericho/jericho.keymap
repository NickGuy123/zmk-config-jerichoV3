/*
 * Jericho V3 - default keymap
 *
 * Binding order on every layer MUST follow the matrix_transform map in
 * jericho.overlay: row3, row2, row1, row0 (12 keys each, left to right),
 * then the 4 thumb keys (row4, columns 4-7). Swap keys around freely,
 * just keep the same number/order of bindings per layer (52 total).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1 &kp N2 &kp N3 &kp N4 &kp N5      &kp N6 &kp N7    &kp N8   &kp N9    &kp N0     &kp EQUAL
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T       &kp Y  &kp U     &kp I    &kp O     &kp P     &kp MINUS
&mo 1      &kp A  &kp S  &kp D  &kp F  &kp G       &kp H  &kp J     &kp K    &kp L     &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B       &kp N  &kp M     &kp COMMA &kp DOT  &kp FSLH  &kp RALT
                         &kp LSHIFT &kp BSPC               &kp SPACE &kp RET
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp F1    &kp F2   &kp F3   &kp F4   &kp F5   &kp F6      &kp F7    &kp F8     &kp F9    &kp F10   &kp F11 &kp F12
&kp TILDE &kp PIPE &kp LBRC &kp RBRC &kp BSLH &trans      &trans    &kp UP     &trans    &trans    &trans  &trans
&trans    &trans   &trans   &trans   &kp LBKT &kp RBKT    &kp LEFT  &kp DOWN   &kp RIGHT &trans    &trans  &trans
&trans    &trans   &trans   &trans   &trans   &trans      &trans    &trans     &trans    &trans    &trans  &trans
                       &trans &trans                 &trans    &trans
            >;
        };
    };
};
